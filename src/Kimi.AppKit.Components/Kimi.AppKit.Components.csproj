<Project Sdk="Microsoft.NET.Sdk.Razor">
    <PropertyGroup>
        <Description>Kimi.AppKit 的标准化 Blazor 组件库。渲染模式无关：静态 SSR / InteractiveServer / WebAssembly 三种模式通用。</Description>
    </PropertyGroup>
    <ItemGroup>
        <SupportedPlatform Include="browser" />
        <PackageReference Include="MudBlazor" />
        <!-- AuthorizeView 等授权组件不在共享框架里（这是 RCL，不是 Web SDK 项目），须显式引用。 -->
        <PackageReference Include="Microsoft.AspNetCore.Components.Authorization" />
        <!-- KEnvChip 需要 WASM 端的 IKEnvironment 实现（KWasmEnvironment）。
             ⚠️ 只在客户端触发注册，服务端渲染这个库时该包不产生任何运行时行为。 -->
        <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" />
        <!-- KHostEnvironment（服务端 IKEnvironment 实现）需要 IHostEnvironment。 -->
        <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
    </ItemGroup>
    <ItemGroup>
        <ProjectReference Include="..\Kimi.AppKit.Core\Kimi.AppKit.Core.csproj" />
        <ProjectReference Include="..\Kimi.AppKit.Design\Kimi.AppKit.Design.csproj" />
    </ItemGroup>
</Project>
