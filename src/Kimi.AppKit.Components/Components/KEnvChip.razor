@using Kimi.AppKit.Core.Abstractions
@inject IKEnvironment Environment
@* 非生产环境警示条。
   ⚠️ 这不是装饰——生产配置守卫与异常页脱敏都按环境分支，哪个环境在跑必须一眼可见，
   否则漏设环境变量的实例会被当成正式站交付。免密调试登录之类的开关也常按
   `!IsProduction` 放行，改界面时不要顺手删掉这个组件。
   生产环境下不渲染任何内容（不占布局空间）。 *@
@if (!Environment.IsProduction)
{
    <span class="k-envchip">@Environment.Name</span>
}
