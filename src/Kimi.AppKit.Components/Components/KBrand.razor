@* 侧栏/顶栏的品牌区：Logo 或首字母标记 + 公司名/产品名。
   ⚠️ 只接受纯参数，不依赖任何具体的品牌数据模型——品牌信息从哪来（数据库、配置、
   远程服务）是消费方的事，这个组件只管怎么摆放。*@
<a href="@Href" class="k-brand">
    @if (LogoUrl is { Length: > 0 })
    {
        <img src="@LogoUrl" alt="" class="k-brand__logo" />
    }
    else
    {
        <KAvatar Name="@CompanyName" CssClass="k-mark" />
    }
    <span class="k-brand__names">
        <span class="k-brand__company">@CompanyName</span>
        @if (!string.IsNullOrWhiteSpace(ProductName))
        {
            <span class="k-brand__product">@ProductName</span>
        }
    </span>
</a>

@code {
    /// <summary>公司名。用于首字母兜底与展示。</summary>
    [Parameter, EditorRequired] public string CompanyName { get; set; } = string.Empty;

    /// <summary>产品名。为空时不渲染第二行。</summary>
    [Parameter] public string? ProductName { get; set; }

    /// <summary>Logo 地址。为空时退回首字母标记。</summary>
    [Parameter] public string? LogoUrl { get; set; }

    /// <summary>点击品牌区跳转的地址。默认站内首页。</summary>
    [Parameter] public string Href { get; set; } = "/";
}
