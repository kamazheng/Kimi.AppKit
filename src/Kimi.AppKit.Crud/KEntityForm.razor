@* 反射驱动的实体表单：字段由 EntityPropertyInspector 从 T 反射出来，外壳复用 KCrudLayout。
   Id 字段永远只读，即使整个表单不是只读模式——主键从来不该被手工改。*@
@typeparam T where T : class

<KCrudLayout T="T" Model="Model" ReadOnly="ReadOnly" ShowDelete="ShowDelete"
             OnValidSubmit="OnValidSubmit" OnDelete="OnDelete" OnCancel="OnCancel"
             SubmitLabel="@SubmitLabel" DeleteLabel="@DeleteLabel"
             ShowActionBar="ShowActionBar" FormId="@FormId">
    <MudGrid Class="pa-2">
        @foreach (var property in VisibleProperties)
        {
            <MudItem xs="12" sm="6" md="4">
                <KEntityField Model="Model" Property="property"
                              ReadOnly="@EntityPropertyInspector.IsFieldReadOnly(property, Model, ReadOnly, FieldReadOnly)" />
            </MudItem>
        }
    </MudGrid>
</KCrudLayout>

@code {
    private IReadOnlyList<PropertyInfo> _properties = [];

    [Parameter, EditorRequired] public T Model { get; set; } = null!;

    [Parameter] public bool ReadOnly { get; set; }

    /// <summary>是否显示删除按钮。新建场景传 false。</summary>
    [Parameter] public bool ShowDelete { get; set; }

    /// <summary>排除指定接口自带的属性（如 <c>ISoftDeleteEntity</c>），不出现在表单里。</summary>
    [Parameter] public IEnumerable<Type>? ExcludeInterfaces { get; set; }

    /// <summary>校验通过后触发，携带的是同一个（已被反射写入新值的）<see cref="Model"/> 实例。</summary>
    [Parameter] public EventCallback<T> OnValidSubmit { get; set; }

    [Parameter] public EventCallback OnDelete { get; set; }

    /// <summary>取消。未绑定时不渲染取消按钮。</summary>
    [Parameter] public EventCallback OnCancel { get; set; }

    [Parameter] public string SubmitLabel { get; set; } = "保存";

    [Parameter] public string DeleteLabel { get; set; } = "删除";

    /// <summary>是否渲染自带的操作栏。对话框里应传 false——动作按钮归 DialogActions。</summary>
    [Parameter] public bool ShowActionBar { get; set; } = true;

    /// <summary>表单元素 id，供表单外的提交按钮用 <c>form=</c> 关联。</summary>
    [Parameter] public string? FormId { get; set; }

    /// <summary>
    /// 隐藏主键字段。新增场景应传 true。
    /// </summary>
    /// <remarks>
    /// ⚠️ 主键是数据库生成的，新增表单上显示一个只读的 <c>0</c> 既无意义又让人以为要填。
    /// 编辑场景保留（只读），因为报障时那个值是定位记录的依据。
    /// </remarks>
    [Parameter] public bool HideIdentity { get; set; }

    /// <summary>
    /// 按"实体实例 + 属性名"追加只读规则，供业务页表达框架无法预知的锁定语义
    /// （如"系统内置的记录只能改值和说明"）。与内置规则（整表单只读/主键）按更严格的一边叠加，
    /// 不会把框架保护的字段重新打开为可编辑。
    /// </summary>
    [Parameter] public Func<T, string, bool>? FieldReadOnly { get; set; }

    private IEnumerable<PropertyInfo> VisibleProperties =>
        HideIdentity ? _properties.Where(p => !EntityPropertyInspector.IsIdProperty(p)) : _properties;

    protected override void OnInitialized() =>
        _properties = EntityPropertyInspector.GetEditableProperties(typeof(T), ExcludeInterfaces);
}
