<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <!-- ⚠️ <clear /> 不可省：不清空的话会继承 ~/.nuget/NuGet/NuGet.Config 里的包源
         （本机上有一个 Company 内网 Nexus）。继承的后果是「本机能构建、换台机器就挂」，
         而 CI 上的报错只是笼统的「找不到包」，查起来很费时间。 -->
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
