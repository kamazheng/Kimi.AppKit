<Project>

    <!--
      中央包版本管理（CPM）。全仓所有 <PackageReference> 一律**不写 Version**，版本只在这里定义一次。

      为什么启用：原模板里 OpenTelemetry 家族的版本号重复 10 条、EFCore 系列重复多处，
      升级时漏改一条就会出现「同一家族跨版本混用」——NuGet 只在少数情况下报错，
      多数时候是静默选一个较高版本，运行期才暴露。

      ⚠️ MudBlazor 当前为 9.x。升级 MudBlazor 主版本前先确认依赖它的第三方扩展已跟进。
    -->

    <PropertyGroup>
        <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
        <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
    </PropertyGroup>

    <!-- ── 构建与打包基础设施 ────────────────────────────────────────── -->
    <ItemGroup>
        <PackageVersion Include="MinVer" Version="7.0.0" />
        <PackageVersion Include="DotNet.ReproducibleBuilds" Version="2.0.5" />
        <PackageVersion Include="Microsoft.SourceLink.GitHub" Version="10.0.400" />
    </ItemGroup>

    <!-- ── ASP.NET Core / EF Core（整族对齐 10.0.11）──────────────────── -->
    <ItemGroup>
        <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.11" />
        <PackageVersion Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" Version="10.0.11" />
        <PackageVersion Include="Microsoft.AspNetCore.Components.Authorization" Version="10.0.11" />
        <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.11" />
        <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly.Authentication" Version="10.0.11" />
        <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.11" />
        <PackageVersion Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.11" />
        <PackageVersion Include="Microsoft.Extensions.Diagnostics.HealthChecks.EntityFrameworkCore" Version="10.0.11" />
        <PackageVersion Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.11" />
        <PackageVersion Include="Microsoft.Extensions.Http" Version="10.0.11" />
        <PackageVersion Include="Microsoft.Extensions.Localization.Abstractions" Version="10.0.11" />
        <PackageVersion Include="Microsoft.Extensions.Options" Version="10.0.11" />
        <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    </ItemGroup>


    <!-- ── 可观测性（整族对齐 1.18.0，全部正式版）────────────────────────
         ⚠️ 这里**刻意不列** Prometheus 导出器与 EventCounters：二者至今只有 beta/alpha，
            不该进一个要发版的包的依赖链。应用只推 OTLP，由 Collector 负责再导出给
            Prometheus——这也是 OTel 的标准拓扑，不需要每个应用自己开抓取端点。
         `Instrumentation.SqlClient` 在 1.18.0 已经转正（原先是 beta）。
         ⚠️ 原模板对 GHSA-4625-4j76-fww9 的 NuGetAuditSuppress 已随本次升级删除：
            该建议的修复版本是 1.15.3+，1.18.0 已涵盖。 -->
    <ItemGroup>
        <PackageVersion Include="OpenTelemetry" Version="1.18.0" />
        <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.18.0" />
        <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.18.0" />
        <PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.18.0" />
        <PackageVersion Include="OpenTelemetry.Instrumentation.Http" Version="1.18.0" />
        <PackageVersion Include="OpenTelemetry.Instrumentation.Runtime" Version="1.18.0" />
        <PackageVersion Include="OpenTelemetry.Instrumentation.SqlClient" Version="1.18.0" />
    </ItemGroup>

    <!-- ── 后台任务 ───────────────────────────────────────────────────── -->
    <ItemGroup>
        <PackageVersion Include="Hangfire" Version="1.8.25" />
        <PackageVersion Include="Hangfire.Console" Version="1.4.3" />
        <!-- PG 存储（Hangfire.PostgreSql）刻意不在此登记：Kimi.AppKit.Web 不引用它
             （那会把 PG 驱动强加给只用 SQL Server 的消费方），由消费方按需引入，
             并经 AddAppKitHangfire 的 configurePostgres 接线。 -->
    </ItemGroup>

    <!-- ── UI（MudBlazor 9.x）────────────────────────────────────────
         ⚠️ MudBlazor 一律钉死具体版本，禁用浮动 `9.*`：浮动会在每次 restore/部署
            静默升级，曾导致文件上传行为在无代码改动的情况下回归。

         ⚠️ 不要加回 MudBlazor.ThemeManager / FormCraft / FormCraft.ForMudBlazor。
            三者已随 P7b/P7c 删除且**没有任何引用方**：
            - ThemeManager 是给终端用户的运行期调色板，决策 #8 明确否决
              （每个人看到的界面都不一样，截图与工单对不上）。配色改由
              Kimi.AppKit.Design 的 AppKitTheme 提供。
            - FormCraft 与 Kimi.AppKit.Crud 的 KEntityForm 职责重叠，
              两套并存正是「不知道该用哪个」的成因。 -->
    <ItemGroup>
        <PackageVersion Include="MudBlazor" Version="9.9.0" />
    </ItemGroup>


    <!-- ── 传递依赖的安全提版 ──────────────────────────────────────────
         这些包没有任何工程直接引用，靠 CentralPackageTransitivePinningEnabled 提版。
         删除任何一条之前，先跑 `dotnet restore` 确认审计不再报 NU1903。 -->
    <ItemGroup>
        <!-- ClosedXML 0.105.x 依赖 SixLabors.Fonts [1.0.0,3.0.0)。
             ⚠️ **只能停在 1.0.x：2.x 起改用 Six Labors Split License**，闭源商业使用需另购授权；
             1.0.x 是 Apache-2.0 且无安全公告。升 ClosedXML 前先确认它没有抬高 Fonts 的下限。 -->
        <PackageVersion Include="SixLabors.Fonts" Version="1.0.1" />

        <!-- Hangfire 依赖 Newtonsoft.Json 11.0.1（1 个 high severity 建议，
             GHSA-5crp-9r3c-p9vr）。Hangfire 自身没跟进，只能在这里提版。 -->
        <PackageVersion Include="Newtonsoft.Json" Version="13.0.4" />
    </ItemGroup>

    <!-- ── 其它 ───────────────────────────────────────────────────────── -->
    <ItemGroup>
        <!-- 类型安全的 REST 客户端（决策 14 取代自写的 IStandardApi 家族）。
             ⚠️ 注册一律用 AddRefitGeneratedClient<T>()，**不要**用 AddRefitClient<T>()——
                后者走反射，在 trimmed / Native AOT 的 WASM 下会静默退化或抛。 -->
        <PackageVersion Include="Refit" Version="15.2.0" />
        <PackageVersion Include="Refit.HttpClientFactory" Version="15.2.0" />
        <!-- ⚠️ 不要加回 Microsoft.EntityFrameworkCore.DynamicLinq。
             它唯一的用途是让通用查询端点解析客户端传来的过滤表达式字符串，
             那正是 P2 量化判定「不抽」的能力（MES 里 0 使用），P7c 已连同输入口一并移除。
             列表查询走 Kimi.AppKit.Data 的 ReflectiveCrudDataSource（表达式树 + 属性白名单）。 -->
        <!-- Excel：ClosedXML（MIT），不用 NPOI。为什么（决策记录，勿凭印象换回）：
             · NPOI 2.7.x（Apache-2.0）依赖 SixLabors.ImageSharp 2.x，该系列 5 条公告（2026-10-07）
               覆盖 2.x 全线、唯一修复版 4.1.2；NPOI 2.7.6 仍依赖 ImageSharp 2.1.11，升级无解。
             · NPOI 2.8+ 起二进制包改用 OSMF 维护费协议（营利且年营收 ≥ US$10,000 须付费，
               构建时还要求 <AcceptNPOIOSMFLicense>true</AcceptNPOIOSMFLicense>），本产品是对外销售的商业软件。
             · ImageSharp 4.x 是 Six Labors Split License，闭源商业使用需购授权。
             ClosedXML 不依赖 ImageSharp / BouncyCastle / NPOI 一族。
             复杂带样式报表由应用直引 ClosedXML（版本经 CPM 与此处一致）。 -->
        <PackageVersion Include="ClosedXML" Version="0.105.1" />
        <!-- 邮件。⚠️ 刻意不用 System.Net.Mail.SmtpClient——微软官方文档原话是
             「不应当用于新开发」，并直接点名 MailKit 作为替代。这不是风格问题：
             SmtpClient 对现代 TLS 与 OAuth2 支持不足，连不上 Office 365 这类服务。 -->
        <PackageVersion Include="MailKit" Version="4.17.0" />
        <PackageVersion Include="System.IdentityModel.Tokens.Jwt" Version="8.22.0" />
        <PackageVersion Include="Microsoft.IdentityModel.Protocols.OpenIdConnect" Version="8.22.0" />
    </ItemGroup>

    <!-- 测试用的 provider。SQLite 内存模式能真正跑事务与约束，
         比 EFCore.InMemory 有意义得多（后者不支持事务、不校验约束，
         测不出「两阶段保存要在同一事务里」这类行为）。 -->
    <ItemGroup>
        <PackageVersion Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.11" />
        <!-- 进程内起 Kestrel 打真实 HTTP 请求。端点的授权、路由优先级、模型绑定
             这三样都只有真发一次请求才验得到——直接 new 出 handler 调用测不出任何一条。 -->
        <PackageVersion Include="Microsoft.AspNetCore.TestHost" Version="10.0.11" />
        <!-- ⚠️ 仅测试用，包本身不依赖 Identity。
             它存在是为了用**真的** IdentityDbContext 验证「基类名额已被占用的上下文
             也能接上审计」——这正是 AuditableDbContext 做成基类时接不上的那个场景。
             换成自造的基类替身就又变成「自己写的消费方」，测不出真实约束。 -->
        <PackageVersion Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.11" />
        <PackageVersion Include="bunit" Version="2.9.0" />
        <PackageVersion Include="Testcontainers.PostgreSql" Version="4.14.0" />
        <PackageVersion Include="Testcontainers.MsSql" Version="4.14.0" />
    </ItemGroup>

    <!-- ── 测试 ───────────────────────────────────────────────────────── -->
    <ItemGroup>
        <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.9.0" />
        <PackageVersion Include="xunit" Version="2.9.3" />
        <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.0" />
        <PackageVersion Include="coverlet.collector" Version="10.0.1" />
    
        <!-- API 文档：内置 OpenAPI 生成 + Scalar 提供 UI。 -->
        <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.11" />
        <PackageVersion Include="Scalar.AspNetCore" Version="2.16.20" />
</ItemGroup>

</Project>
