<Project>

    <!--
      中央包版本管理（CPM）。本目录下所有 <PackageReference> 一律**不写 Version**，
      版本只在这里定义一次。

      ⚠️ 必须**自包含**，理由同 Directory.Build.props：NuGet 同样是「找到最近的一个
         就停」。没有本文件时，本目录会去用仓库根那份——那份是给 src/ 下的包工程用的，
         不含样例需要的包，表现为 NU1008 而不是「缺了某个版本号」。

      ⚠️ 版本对齐 10.0.11 而非模板生成时的 10.0.8：那是本仓库已验证过的 ASP.NET Core
         版本线（见 AppTemplate/Directory.Packages.props），混用两条线会在 WASM 侧
         出现方法签名不符，且只有浏览器里才炸。
    -->

    <PropertyGroup>
        <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
        <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
    </PropertyGroup>

    <PropertyGroup>
        <!--
          Kimi.AppKit.* 包的版本。打模板包时由 Kimi.AppKit.Templates.csproj 替换成
          与模板包同一个版本号——模板与它引用的框架包必须同版本发布，
          否则生成出来的项目会拿到一份与模板内容对不上的包。
          仓库内开发时走 ProjectReference，本值不参与解析。
        -->
        <KimiAppKitVersion>0.0.0-local</KimiAppKitVersion>
    </PropertyGroup>

    <ItemGroup>
        <PackageVersion Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.11" />
        <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.11" />
        <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
        <PackageVersion Include="Microsoft.AspNetCore.Authorization" Version="10.0.11" />
        <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.11" />
        <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly.Server" Version="10.0.11" />
    </ItemGroup>

    <!-- ── Kimi.AppKit 框架包 ─────────────────────────────────────────── -->
    <ItemGroup>
        <PackageVersion Include="Kimi.AppKit.Core" Version="$(KimiAppKitVersion)" />
        <PackageVersion Include="Kimi.AppKit.Data" Version="$(KimiAppKitVersion)" />
        <PackageVersion Include="Kimi.AppKit.Web" Version="$(KimiAppKitVersion)" />
        <PackageVersion Include="Kimi.AppKit.Design" Version="$(KimiAppKitVersion)" />
        <PackageVersion Include="Kimi.AppKit.Components" Version="$(KimiAppKitVersion)" />
        <PackageVersion Include="Kimi.AppKit.Crud" Version="$(KimiAppKitVersion)" />
        <PackageVersion Include="Kimi.AppKit.Observability" Version="$(KimiAppKitVersion)" />
        <PackageVersion Include="Kimi.AppKit.Http" Version="$(KimiAppKitVersion)" />
    </ItemGroup>

    <!-- PG 存储。Kimi.AppKit.Web 刻意不引用它（那会把 PG 驱动强加给只用 SQL Server 的
         消费方），由本层引入并经 AddAppKitHangfire 的 configurePostgres 接线。 -->
    <ItemGroup>
        <PackageVersion Include="Hangfire.PostgreSql" Version="1.21.1" />
    </ItemGroup>

    <!-- ── UI ──────────────────────────────────────────────────────────
         ⚠️ MudBlazor 一律钉死具体版本，禁用浮动 `9.*`：浮动会在每次 restore/部署
            静默升级，曾导致文件上传行为在无代码改动的情况下回归。 -->
    <ItemGroup>
        <PackageVersion Include="MudBlazor" Version="9.9.0" />
    </ItemGroup>

    <!-- ── 传递依赖的安全提版 ──────────────────────────────────────────
         这些包没有任何工程直接引用，靠 CentralPackageTransitivePinningEnabled 提版。
         它们随 Kimi.AppKit.Web 的 Hangfire 进来。
         删除任何一条之前，先跑 `dotnet restore` 确认审计不再报 NU1902/NU1903。 -->
    <ItemGroup>
        <!-- Hangfire 依赖 Newtonsoft.Json 11.0.1（1 个 high severity 建议，
             GHSA-5crp-9r3c-p9vr）。Hangfire 自身没跟进，只能在这里提版。 -->
        <PackageVersion Include="Newtonsoft.Json" Version="13.0.4" />
    
        <!-- 测试。⚠️ 版本与包仓库保持一致，避免生成的项目在还原时撞到 CPM 报错。 -->
        <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.11" />
        <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.9.0" />
        <PackageVersion Include="xunit" Version="2.9.3" />
        <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.0" />
        <PackageVersion Include="coverlet.collector" Version="10.0.1" />

        <!-- API 文档：内置 OpenAPI 生成 + Scalar 提供 UI。
             ⚠️ 不要引 Swashbuckle——.NET 9 起官方模板已移除它。 -->
        <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.11" />
        <PackageVersion Include="Scalar.AspNetCore" Version="2.16.20" />
</ItemGroup>

</Project>
