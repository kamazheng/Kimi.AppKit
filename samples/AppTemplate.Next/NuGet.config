<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    ⚠️ <clear /> 不可省。NuGet 与 MSBuild 不同：它会把从磁盘根到当前目录的**所有**
       NuGet.config 逐层合并，而不是找到第一个就停。不清空的话，仓库根那份、
       以及 ~/.nuget/NuGet/NuGet.Config 里的源都会叠加进来。

    原模板这里配的是 Company 内网 Nexus（`internal.example.com`，还关了 TLS 校验），
    已随去 Company 化移除——客户环境访问不到那个地址，restore 会直接失败。
  -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
