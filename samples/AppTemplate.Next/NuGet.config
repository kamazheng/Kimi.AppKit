<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    ⚠️ <clear /> 不可省。NuGet 与 MSBuild 不同：它会把从磁盘根到当前目录的**所有**
       NuGet.config 逐层合并，而不是找到第一个就停。不清空的话，仓库根那份、
       以及 ~/.nuget/NuGet/NuGet.Config 里的源都会叠加进来。
  -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
  <!--
    源映射：声明所有包都来自 nuget.org。客户内网加私有镜像/代理源时，这是 NuGet 推荐的做法
    （CPM 下多源且无映射，部分 SDK/NuGet 版本会告警 NU1507，TreatWarningsAsErrors 下即失败；
    在本仓所用 SDK 上我们**未能复现**该告警，所以这里只作防御性配置）。
    加私有镜像时：为它单独加一条 <packageSource key="镜像名"><package pattern="..." /></packageSource>，
    其余仍走 `*` → nuget.org。
  -->
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
