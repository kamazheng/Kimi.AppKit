<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    ⚠️ <clear /> 不可省。NuGet 与 MSBuild 不同：它会把从磁盘根到当前目录的**所有**
       NuGet.config 逐层合并，而不是找到第一个就停。不清空的话，仓库根那份、
       以及 ~/.nuget/NuGet/NuGet.Config 里的源都会叠加进来。
  -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
  <!--
    源映射：所有包都来自 nuget.org。⚠️ 不可省——一旦客户在 <packageSources> 里再加一个私有镜像，
    没有映射时 CPM + 多源会触发 NU1507（「有 N 个包源但未配置源映射」），且 TreatWarningsAsErrors 下直接失败。
    加私有镜像时：为它单独加一条 <packageSource key="镜像名"><package pattern="..." /></packageSource>，
    其余仍走 `*` → nuget.org。
  -->
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
