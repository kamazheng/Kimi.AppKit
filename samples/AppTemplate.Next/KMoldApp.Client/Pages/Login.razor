@page "/login"
@inject NavigationManager Nav

<PageTitle>登录</PageTitle>

<MudCard Class="mx-auto mt-8" Style="max-width: 420px;">
    <MudCardContent Class="pa-6">
        <MudText Typo="Typo.h5" Class="mb-2">登录</MudText>
        <MudText Typo="Typo.body2" Class="mb-6 mud-text-secondary">
            使用企业账号登录本系统。
        </MudText>

        @* ⚠️ 必须走 forceLoad，不能用 <a href> 或 MudButton 的 Href。
           /authentication/login 是服务端 minimal API 端点、不是 Blazor 路由，
           而 Blazor 的 Router 会拦截同源 <a> 点击做客户端导航——
           结果是路由找不到该地址、显示 NotFound，请求**根本没发到服务端**。 *@
        <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true"
                   OnClick="@(() => Nav.NavigateTo("/authentication/login", forceLoad: true))">
            用企业账号登录
        </MudButton>
    </MudCardContent>
</MudCard>
