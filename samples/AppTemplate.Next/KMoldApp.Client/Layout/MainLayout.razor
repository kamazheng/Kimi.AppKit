@using KMoldApp.Shared.Constants
@using Kimi.AppKit.Components.Auth
@using Kimi.AppKit.Core.Contracts
@inject IKBrandingSource BrandingSource
@inject NavigationManager Nav
@using Microsoft.AspNetCore.Components.Routing
@implements IDisposable
@inherits LayoutComponentBase

@* ⚠️ 主题与 Provider 必须在布局里、且处于交互式渲染上下文。
   本项目全站 InteractiveWebAssembly，所以 KMudProviders 不用再显式指定渲染模式；
   将来若加入走静态 SSR 的页面（例如需要在响应里种 cookie 的登录页），
   那条路径上的 Provider 要写成 <KMudProviders @@rendermode="InteractiveServer" />，
   否则 Snackbar/Dialog 不报错、只是永远不显示。 *@
<MudThemeProvider Theme="AppKitTheme.Instance" @bind-IsDarkMode="_isDarkMode" />
<KMudProviders />

<MudLayout>
    <MudAppBar Elevation="1">
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start"
                       OnClick="@(() => _drawerOpen = !_drawerOpen)" />
        @* 顶栏放**当前页面标题**，不放品牌——品牌在抽屉顶部（见下方 MudDrawer）。
           ⚠️ 品牌与汉堡按钮挤在一起时，两个视觉重量相当的元素会互相打架；
           而品牌与导航本就是一体的（都在回答「这是什么系统、能去哪」），
           放进抽屉后顶栏才腾得出位置给页面上下文。
           这是 Ant Design Pro / Azure Portal / GitHub 的排法。 *@
        <MudText Typo="Typo.h6" Class="text-truncate">@PageTitle</MudText>

        <MudSpacer />
        <MudIconButton Icon="@(_isDarkMode ? Icons.Material.Filled.LightMode : Icons.Material.Filled.DarkMode)"
                       Color="Color.Inherit" OnClick="@(() => _isDarkMode = !_isDarkMode)"
                       aria-label="切换亮/暗配色" />
        <LoginDisplay />
    </MudAppBar>

    @* ClipMode.Always：抽屉从 AppBar 下方开始，不盖住标题栏。
       缺了它抽屉会顶到页面最上沿，把 AppBar 的汉堡按钮与标题挤到右侧。 *@
    <MudDrawer @bind-Open="_drawerOpen" ClipMode="DrawerClipMode.Always" Elevation="2">
        @* 品牌区。**企业名与 Logo 来自身份服务**（客户只在 Auth 里设一次），
           产品名恒取本地常量——那是本应用自己的名字，不该跟着身份服务的产品名走。
           ⚠️ 放在抽屉里而不是顶栏：品牌与导航同属「这是什么系统、能去哪」，
           视觉上也同处深色区，是一整块；挤到顶栏会和汉堡按钮抢位置。 *@
        <div class="k-drawer-brand">
            @if (_branding.LogoUrl is { } logo)
            {
                <img src="@logo" alt="@_branding.CompanyName" class="k-drawer-logo" />
            }
            else
            {
                @* 未上传 Logo 时的字标。⚠️ 不要用三道横线占位——那和汉堡菜单一模一样。 *@
                <span class="k-drawer-mark" aria-hidden="true">@Initial</span>
            }

            <div class="k-drawer-names">
                <span class="k-drawer-product">@AppBrand.ProductName</span>
                <span class="k-drawer-company">@_branding.CompanyName</span>
            </div>
        </div>

        <NavMenu />
    </MudDrawer>

    @* pt-16 让内容避开 fixed 定位的 AppBar——没有它首屏内容会被标题栏压住。 *@
    <MudMainContent Class="pt-16 pa-4">
        <MudContainer MaxWidth="MaxWidth.Large">
            @* ⚠️ 错误边界包住 @Body：没有它，任何冒泡异常会把完整堆栈
               （含绝对文件路径与 HTTP 头）铺满整个界面。异常呈现走包里的
               ApiErrorPresenter，保证 403/401/其余在任何触发路径下表现一致。 *@
            <KAppErrorBoundary>
                @Body
            </KAppErrorBoundary>
        </MudContainer>
    </MudMainContent>
</MudLayout>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private KBranding _branding = KBranding.Fallback;

    /// <summary>
    /// 顶栏显示的当前页面标题。
    /// </summary>
    /// <remarks>
    /// ⚠️ 刻意**不去读 &lt;PageTitle&gt;**：那个组件把值写进 document.title，
    /// 没有公开的读取口径，硬读要走 JS 互操作，且时机上早于组件渲染完成——
    /// 拿到的经常是上一页的标题。这里按路由映射，来源单一且同步可得。
    /// ⚠️ 新增页面要在这里登记，否则顶栏是空的。宁可空着也不要回落成产品名——
    /// 那会让用户以为自己在首页。
    /// </remarks>
    private string PageTitle => Nav.ToBaseRelativePath(Nav.Uri).Split('?')[0].TrimEnd('/') switch
    {
        "" => "首页",
        "admin/settings" => "系统设置",
        "profile" => "我的账号",
        _ => string.Empty,
    };

    private string Initial =>
        string.IsNullOrWhiteSpace(_branding.CompanyName) ? "?" : _branding.CompanyName[..1].ToUpperInvariant();

    // ⚠️ 服务端预渲染与 WASM 接管各跑一次，两次用的是各自容器里的 IKBrandingSource 实现。
    protected override async Task OnInitializedAsync()
    {
        // ⚠️ **必须订阅路由变化。** 布局组件在页面间导航时**不会重新渲染**，
        //    不订阅的话顶栏标题会一直停在进入应用时的那一页——
        //    点了导航、内容变了、标题没变，看起来像页面没切过去。
        Nav.LocationChanged += OnLocationChanged;

        _branding = await BrandingSource.GetAsync();
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e) => StateHasChanged();

    public void Dispose() => Nav.LocationChanged -= OnLocationChanged;

    private bool _isDarkMode;
    private bool _drawerOpen = true;
}
