@using KMoldApp.Shared.Constants
@using KMoldApp.Shared.Auth
@using Kimi.AppKit.Core.Contracts
@inject IAppBranding BrandingSource
@inherits LayoutComponentBase

@* ⚠️ 主题与 Provider 必须在布局里、且处于交互式渲染上下文。
   本项目全站 InteractiveWebAssembly，所以 KMudProviders 不用再显式指定渲染模式；
   将来若加入走静态 SSR 的页面（例如需要在响应里种 cookie 的登录页），
   那条路径上的 Provider 要写成 <KMudProviders @@rendermode="InteractiveServer" />，
   否则 Snackbar/Dialog 不报错、只是永远不显示。 *@
<MudThemeProvider Theme="AppKitTheme.Instance" @bind-IsDarkMode="_isDarkMode" />
<KMudProviders />

<MudLayout>
    <MudAppBar Elevation="1">
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start"
                       OnClick="@(() => _drawerOpen = !_drawerOpen)" />
        @* 企业标识。**企业名与 Logo 来自身份服务**（客户只在 Auth 里设一次），
           产品名恒取本地常量——那是本应用自己的名字，不该跟着身份服务的产品名走。

           ⚠️ **单行横排，不要竖排两行。** 竖排是登录页那种独立品牌区的排法；
           顶栏是一条紧凑的横条，塞进两行文字会把它撑高一截，且让企业名
           在视觉重量上压过产品名——而用户每天在这里找的是产品名。
           ⚠️ 企业名用分隔点接在产品名后面并压淡：它回答「这是谁家的系统」，
           只需一眼可辨，不需要与产品名争。窄屏整块隐藏。 *@
        @* ⚠️ 间距用内联 style 而不是 MudBlazor 的 ga-*/gap-* 工具类：那些类名随版本变过，
           不生效时 Logo 会和文字**贴在一起**且不报错。 *@
        <div class="d-flex align-center" style="gap:.625rem; min-width:0">
            @if (_branding.LogoUrl is { } logo)
            {
                <img src="@logo" alt="@_branding.CompanyName" class="k-appbar-logo" />
            }
            else
            {
                @* 未上传 Logo 时的字标。⚠️ 不要用三道横线占位——那和汉堡菜单一模一样。 *@
                <span class="k-appbar-mark" aria-hidden="true">@Initial</span>
            }

            <MudText Typo="Typo.h6" Class="text-truncate">@AppBrand.ProductName</MudText>

            <span class="k-appbar-company d-none d-md-flex">@_branding.CompanyName</span>
        </div>
        <MudSpacer />
        <MudIconButton Icon="@(_isDarkMode ? Icons.Material.Filled.LightMode : Icons.Material.Filled.DarkMode)"
                       Color="Color.Inherit" OnClick="@(() => _isDarkMode = !_isDarkMode)"
                       aria-label="切换亮/暗配色" />
        <LoginDisplay />
    </MudAppBar>

    @* ClipMode.Always：抽屉从 AppBar 下方开始，不盖住标题栏。
       缺了它抽屉会顶到页面最上沿，把 AppBar 的汉堡按钮与标题挤到右侧。 *@
    <MudDrawer @bind-Open="_drawerOpen" ClipMode="DrawerClipMode.Always" Elevation="2">
        <NavMenu />
    </MudDrawer>

    @* pt-16 让内容避开 fixed 定位的 AppBar——没有它首屏内容会被标题栏压住。 *@
    <MudMainContent Class="pt-16 pa-4">
        <MudContainer MaxWidth="MaxWidth.Large">
            @* ⚠️ 错误边界包住 @Body：没有它，任何冒泡异常会把完整堆栈
               （含绝对文件路径与 HTTP 头）铺满整个界面。异常呈现走包里的
               ApiErrorPresenter，保证 403/401/其余在任何触发路径下表现一致。 *@
            <AppErrorBoundary>
                @Body
            </AppErrorBoundary>
        </MudContainer>
    </MudMainContent>
</MudLayout>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private KBranding _branding = KBranding.Fallback;

    private string Initial =>
        string.IsNullOrWhiteSpace(_branding.CompanyName) ? "?" : _branding.CompanyName[..1].ToUpperInvariant();

    // ⚠️ 服务端预渲染与 WASM 接管各跑一次，两次用的是各自容器里的 IAppBranding 实现。
    protected override async Task OnInitializedAsync() => _branding = await BrandingSource.GetAsync();

    private bool _isDarkMode;
    private bool _drawerOpen = true;
}
