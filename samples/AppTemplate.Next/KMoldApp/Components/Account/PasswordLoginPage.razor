@layout AuthLayout
@using Kimi.AppKit.Web.Authorization

@* 脱域现场的密码登录（ROPC）。

   ⚠️ **本页刻意是静态 SSR，且不进路由表**——理由见 AuthLayout.razor 顶部。

   ⚠️ **表单只能用原生 <input>，不能用 MudBlazor 的输入控件。**
   MudBlazor 的输入控件不继承 InputBase，在静态 SSR 表单里**不生成 name 属性**，
   于是提交上来所有字段都是空的，而页面看着完全正常、控制台一条错误也没有。 *@

<PageTitle>用工号登录</PageTitle>

<div class="k-auth__col">

    <div class="k-auth__brand">
        @* 未上传 Logo 时的内置字标。⚠️ 不要换成三道横线——那和汉堡菜单图标一模一样，
           用户会去点它，点不动就以为界面坏了。 *@
        <span class="k-auth__mark">K</span>
        <span class="k-auth__names">
            <span class="k-auth__company">KMoldApp</span>
            <span class="k-auth__product">TOOLING MES</span>
        </span>
    </div>

    <div class="k-auth__card">
        <div class="k-rail"><div class="k-rail__fill"></div></div>

        <p class="k-auth__step">现场通道</p>
        <h1 class="k-auth__title">用工号登录</h1>

        @if (Gate != KNetworkGateResult.Allowed)
        {
            <p class="k-auth__lede">这条通道只在车间网段内开放，你现在的网络不在其中。</p>

            @* 说清楚下一步怎么办。只说「拒绝访问」会让人无路可走。 *@
            <div class="k-alert k-alert--warn">
                <span>
                    改用<a class="k-link" href="/authentication/login">企业账号登录</a>即可；
                    如果你确实在车间里，请把这台机器的 IP 报给管理员，加进准入网段。
                </span>
            </div>
        }
        else
        {
            <p class="k-auth__lede">
                车间机器不在域内时走这条通道。平时请优先用企业账号登录——那条路不把密码交给本系统。
            </p>

            @if (!string.IsNullOrEmpty(Error))
            {
                @* ⚠️ 只回显**分类**消息。区分「工号不存在」与「密码不对」等于
                   给攻击者一个账号存在性预言机。 *@
                <div class="k-alert k-alert--error" role="alert">
                    <span>@Error</span>
                </div>
            }

            <form class="k-form" method="post" action="/authentication/password-login">
                <AntiforgeryToken />
                <input type="hidden" name="returnUrl" value="@ReturnUrl" />

                <div class="k-field">
                    <label class="k-label" for="username">工号</label>
                    <input class="k-input" id="username" name="username" type="text"
                           autocomplete="username" autofocus required />
                </div>

                <div class="k-field">
                    <label class="k-label" for="password">密码</label>
                    <input class="k-input" id="password" name="password" type="password"
                           autocomplete="current-password" required />
                </div>

                <button class="k-btn k-btn--primary k-btn--block" type="submit">登录</button>
            </form>

            <div class="k-or">或</div>

            <a class="k-btn k-btn--block" href="/authentication/login">用企业账号登录</a>
        }
    </div>

    @* 地址栏核对是防钓鱼提示，不是装饰：仿冒登录页骗到的正是那些不看地址栏的人。
       环境徽标同理——生产配置守卫与异常页脱敏都按环境分支，哪个环境在跑必须一眼可见。 *@
    <div class="k-auth__foot">
        <span>登录前请核对地址栏：</span>
        <span class="k-auth__host">@Host</span>
        <KEnvChip />
        <span class="k-auth__note">本系统不会通过邮件或聊天工具索要你的密码。</span>
    </div>
</div>

@code {
    /// <summary>网络准入结果。由端点判定后传入——组件自己不再判一次，避免两处判据漂移。</summary>
    [Parameter] public KNetworkGateResult Gate { get; set; }

    /// <summary>登录成功后的回跳地址。</summary>
    [Parameter] public string? ReturnUrl { get; set; }

    /// <summary>失败原因（分类消息）。</summary>
    [Parameter] public string? Error { get; set; }

    /// <summary>当前站点主机名，供用户核对地址栏。</summary>
    [Parameter] public string? Host { get; set; }
}
