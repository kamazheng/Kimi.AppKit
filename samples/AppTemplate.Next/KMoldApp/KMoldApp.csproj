<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\KMoldApp.Client\KMoldApp.Client.csproj" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.Server" />
    <!-- ⚠️ 两个 provider 都引：运行期按 Database:Provider 配置切换。
         Kimi.AppKit.Data 刻意不引用任何具体 provider（那会把不需要的驱动强加给消费方），
         所以由应用这一层引入。 -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="Hangfire.PostgreSql" />
  </ItemGroup>

  <!-- 仓库内开发用 ProjectReference；生成出去的项目用 PackageReference。
       开关见 Directory.Build.props。 -->
  <ItemGroup>
    <ProjectReference Include="..\KMoldApp.Shared\KMoldApp.Shared.csproj" />
    <ProjectReference Include="..\KMoldApp.Data\KMoldApp.Data.csproj" />
  </ItemGroup>

  <!-- API 文档。⚠️ 不在 KimiAppKitLocalDev 条件组里——它们与包的来源无关，
       放进条件组会让仓库内开发时根本引不到。 -->
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Scalar.AspNetCore" />
  </ItemGroup>

  <ItemGroup Condition="'$(KimiAppKitLocalDev)' == 'true'">
    <ProjectReference Include="..\..\..\src\Kimi.AppKit.Web\Kimi.AppKit.Web.csproj" />
    <ProjectReference Include="..\..\..\src\Kimi.AppKit.Crud\Kimi.AppKit.Crud.csproj" />
    <ProjectReference Include="..\..\..\src\Kimi.AppKit.Observability\Kimi.AppKit.Observability.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(KimiAppKitLocalDev)' != 'true'">
    <PackageReference Include="Kimi.AppKit.Web" />
    <PackageReference Include="Kimi.AppKit.Crud" />
    <PackageReference Include="Kimi.AppKit.Observability" />
  </ItemGroup>

</Project>
