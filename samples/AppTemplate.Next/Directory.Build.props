<Project>

    <!--
      X2 新骨架的公共构建属性。

      ⚠️ 必须**自包含**，不要 Import 仓库根那份。
         MSBuild 找到第一个 Directory.Build.props 就停止向上查找，所以在 Kimi.AppKit
         仓库里它遮蔽了根那份；而将来 `dotnet new` 生成出来的项目根本不在这个仓库里，
         Import 会直接失败。AppTemplate 那边曾靠 Import 拿 TargetFramework，
         生成的项目因此**静默**退回 SDK 默认框架。
    -->

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <LangVersion>latest</LangVersion>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>

        <!--
          警告即错误。告警一旦允许存在，数量只会单向增长：几十条噪音里没人看得见
          新冒出来的那条真问题。
          ⚠️ 需要临时豁免时在**具体工程**里加 NoWarn 并写明理由，不要在这里整体关掉。
        -->
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
        <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
    </PropertyGroup>

    <PropertyGroup>
        <!--
          仓库内开发标记。各工程据此在两种引包方式间切换：
            true （仅 Kimi.AppKit 仓库内）→ ProjectReference，改包立刻生效，不必先发版
            false（dotnet new 生成的项目）→ PackageReference，拿 nuget.org 上的正式包

          ⚠️ 靠**探测包源码是否就在旁边**来判断，而不是靠「模板打包时排除本文件」。
             排除规则与文件内容是两份真相，一旦对不上就会生成出「带着指向不存在目录的
             ProjectReference」的项目，而那种错误直到还原包时才报、信息指不到真正原因。
             用 Exists() 则只有一份真相：源码在 → 用源码；不在 → 用包。
        -->
        <KimiAppKitLocalDev Condition="'$(KimiAppKitLocalDev)' == '' And Exists('$(MSBuildThisFileDirectory)../../src/Kimi.AppKit.Core/Kimi.AppKit.Core.csproj')">true</KimiAppKitLocalDev>
        <KimiAppKitLocalDev Condition="'$(KimiAppKitLocalDev)' == ''">false</KimiAppKitLocalDev>
    </PropertyGroup>

</Project>
